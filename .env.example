# OpenRouter API key — get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model used for course + lesson generation (must be an OpenRouter model id)
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# PostgreSQL connection string (Neon-compatible).
# Neon: postgresql://USER:PASSWORD@HOST/dbname?sslmode=require
DATABASE_URL=

# NextAuth — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Optional: enable GitHub OAuth (leave blank to hide the button)
GITHUB_ID=
GITHUB_SECRET=
